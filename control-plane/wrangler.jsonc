{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentsight-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "https://app.agentsight.us"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsight-control",
      "database_id": "19e9a84d-25a7-4bb7-8de8-f1ba01b89862"
    }
  ],
  "ratelimits": [
    {
      "name": "OAUTH_IP_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "OAUTH_GLOBAL_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
