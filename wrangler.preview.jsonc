{
  "$schema": "controller/node_modules/wrangler/config-schema.json",
  "name": "agentsight-preview",
  "main": "controller/src/index.ts",
  "account_id": "d9c543e4c98332379705cad72b658b78",
  "compatibility_date": "2026-08-11",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/prepare-sample.mjs && npm ci && npm run build",
    "cwd": "frontend",
    "watch_dir": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/v1/*"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://agentsight-preview.yunwei356.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsight-preview",
      "database_id": "88bebaa8-1d66-47d9-8593-285855a99eb7",
      "migrations_dir": "./controller/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NODE_RELAY", "class_name": "NodeRelay" }
    ]
  },
  "migrations": [
    { "tag": "relay-v1", "new_sqlite_classes": ["NodeRelay"] }
  ],
  "ratelimits": [
    {
      "name": "OAUTH_IP_LIMITER",
      "namespace_id": "41003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "OAUTH_LOCATION_LIMITER",
      "namespace_id": "41004",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
