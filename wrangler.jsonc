{
  "$schema": "controller/node_modules/wrangler/config-schema.json",
  "name": "agentsight",
  "main": "controller/src/index.ts",
  "account_id": "d9c543e4c98332379705cad72b658b78",
  "compatibility_date": "2026-08-11",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/prepare-sample.mjs && npm ci && node scripts/build-workers.mjs --workers-ci",
    "cwd": "frontend",
    "watch_dir": "frontend"
  },
  "assets": {
    "directory": "./frontend/dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/v1/*"
    ]
  },
  "routes": [
    { "pattern": "app.agentsight.us", "custom_domain": true },
    { "pattern": "control.agentsight.us", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.agentsight.us",
    "APP_PREVIEW_ORIGIN_SUFFIX": "-agentsight.yunwei356.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsight",
      "database_id": "0af07d38-8325-4814-9d8d-c21c91b74a55",
      "migrations_dir": "./controller/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NODE_RELAY", "class_name": "NodeRelay" }
    ]
  },
  "migrations": [
    { "tag": "relay-v1", "new_sqlite_classes": ["NodeRelay"] }
  ],
  "ratelimits": [
    {
      "name": "OAUTH_IP_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "OAUTH_LOCATION_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
