      "selected_group_id_rank_3",
      "confidence_1_to_5",
      "visible_evidence_fields",
      "time_seconds"
    ],
    "secondary_endpoints": [
      "selected positive recall",
      "selected positive precision",
      "selected operation work fraction",
      "time to first accepted evidence",
      "confidence calibration against hidden positive rate"
    ],
    "task_repetition_policy": "Each participant sees each problem once under one view; view assignment rotates across participants so each task-view cell has equal replication.",
    "tasks": 6,
    "trials": 144,
    "views": [
      "flat",
      "fixed_session",
      "operation_stack"
    ]
