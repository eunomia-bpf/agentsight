{
  "claim_scope": {
    "narrowed": "fixed-session packets remain cheaper on some first-positive work metrics, so operation stacks are a configurable inspectability tradeoff rather than a universal winner",
    "not_supported": "human analyst accuracy/time improvement, automatic anomaly detection, or dominance over every baseline on every metric",
    "supported": "operation-stack packets expose early positive and high-lift evidence on existing labeled analyst tasks while staying much more selective than flat packets"
  },
  "groups_per_task": 5,
  "headline": "R308 scores analyst-outcome proxies on the R305 label-hidden packets. Operation-stack packets contain a positive group in 6/6 tasks and a >=1.5x high-lift group in 5/6 tasks. Fixed-session packets reach 5/6 and 4/6; flat packets reach 6/6 and 0/6. Operation stacks keep median selected work at 9.4% with recall 18.8% and top-group lift 1.574.",
  "high_lift_threshold": 1.5,
  "input_policy": "no dataset sync; reads tracked R305 visible packets and answer key only",
  "outputs": {
    "html": "docs/visexp/out/operation-analyst-outcome-r308/index.html",
