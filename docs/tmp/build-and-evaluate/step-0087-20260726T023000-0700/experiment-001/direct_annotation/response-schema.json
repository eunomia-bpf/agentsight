{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "marks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "semantic_path": {
            "items": {
              "pattern": "^(repeat|recover|understand|plan|search|locate|navigate|extract|compare|compute|diagnose|reproduce|test|edit|build|configure|verify|validate|coordinate|authenticate|update|create|remove|deploy|submit|escalate|communicate|report|resolve|collect|read|inspect|execute)( [a-z0-9-]+){0,2}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "start_operation_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "start_operation_id",
          "semantic_path"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "session": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "session",
    "marks"
  ],
  "type": "object"
}
