      "operation_id": "test:532:12",
      "ordinal": 11,
      "source_summary": {
        "content": "Confirm the broadcast but exclude station PA announcements to prevent public panic - use only SMS, app push, and digital signs for this critical alert. Proceed with the approved message and instructions using dispatcher ID DISP_4567 and confirmation code CFRM_1234.",
        "role": "user"
      }
    },
    {
