      "ordinal": 12,
      "source_summary": {
        "action": "{\"name\": \"broadcastEmergencyAlert\", \"arguments\": {\"alertType\": \"service_emergency\", \"severity\": \"critical\", \"affectedAreas\": [\"Central Station\", \"Riverside Station\"], \"alertMessage\": \"Emergency: Power outage on Blue Line between Central Station and Riverside Station. Service suspended.\", \"instructions\": [\"Seek alternative transportation\", \"Check website for updates\"], \"broadcastChannels\": [\"sms\", \"app_push\", \"station_pa\", \"digital_signs\"], \"dispatcherId\": \"DISP_4567\", \"emergencyCoordinatorApproval\": \"AUTH_7890\", \"confirmationCode\": \"CFRM_1234\"}}",
