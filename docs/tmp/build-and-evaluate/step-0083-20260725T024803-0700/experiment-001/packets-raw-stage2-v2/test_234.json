      }
    },
    {
      "operation_id": "test:234:24",
      "ordinal": 21,
      "source_summary": {
        "content": "John Doe, johndoe@email.com, offering $740,000 conventional loan with $20,000 earnest money, contingencies for inspection and financing, and 48-hour expiration.",
