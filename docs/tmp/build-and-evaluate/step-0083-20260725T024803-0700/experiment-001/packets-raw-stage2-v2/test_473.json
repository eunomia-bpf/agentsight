  "selected_evidence": [
    {
      "operation_id": "test:473:1",
      "ordinal": 1,
      "source_summary": {
        "content": "A train collision on the Green Line between Oak and Maple stations during rush hour has caused injuries and major disruptions; I require real-time service impact retrieval, emergency notifications to passengers with alternative transport details, immediate refund processing for affected journeys, and formal certification of incident documentation for compliance.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:473:3",
      "ordinal": 3,
      "source_summary": {
        "content": "{\"disruptions\": [{\"routeId\": \"Green Line\", \"affectedStops\": [\"Oak Station\", \"Maple Station\", \"Pine Station\"], \"severity\": \"severe\", \"description\": \"Service suspended between Oak and Maple due to collision\"}]}",
        "role": "environment"
      }
    },
    {
      "operation_id": "test:473:7",
      "ordinal": 7,
      "source_summary": {
        "content": "The incident ID requiring certification is INC2023-GRN-789.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:473:9",
      "ordinal": 9,
      "source_summary": {
        "content": "Dispatcher ID is DISP-789, emergency coordinator approval code is AUTH-20231015, and confirmation code is CONFIRM-456. I confirm the emergency broadcast content and delivery methods as outlined.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:473:14",
      "ordinal": 13,
      "source_summary": {
        "content": "For the bulk refund processing on incident INC2023-GRN-789, set refundScope to time_window from 2023-10-15T08:00:00Z to 2023-10-15T10:00:00Z with 100% refund via original_payment method, estimated total $5000. Justification: Full refund per emergency protocol. Requester ID REF-AGENT-07, finance approval FIN-APPROVE-789, confirmation code BULKREF-2023-GRN.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:473:17",
      "ordinal": 16,
      "source_summary": {
        "content": "The bulk refund processing failed because disruptionId INC2023-GRN-789 was invalid; incident recording failed during emergency broadcast BROAD-2023-10-15-12345 due to authorization issues blocking official registration. I recommend manual refund processing and incident documentation updates.",
        "role": "agent"
      }
    },
    {
      "operation_id": "test:473:20",
      "ordinal": 19,
      "source_summary": {
        "content": "Based on the emergency broadcast (BROAD-2023-10-15-12345) documenting the Green Line collision between Oak and Maple stations at 08:15 UTC on October 15, 2023, I've prepared the incident report for certification. Please provide your signer ID, signer title, legal review approval, and digital signature to formally certify the documentation.",
        "role": "agent"
      }
    },
    {
      "operation_id": "test:473:21",
      "ordinal": 20,
      "source_summary": {
        "content": "I confirm the certification and provide the signing credentials: signerId AUTH-OFFICER-789, signerTitle Chief Safety Officer, legalReviewApproval LEGAL-20231015-ABC, and digitalSignature SIG-TOKEN-X7Y9Z.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:473:24",
