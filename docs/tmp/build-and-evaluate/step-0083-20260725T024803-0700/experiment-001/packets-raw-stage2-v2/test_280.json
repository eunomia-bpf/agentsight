  "selected_evidence": [
    {
      "operation_id": "test:280:1",
      "ordinal": 1,
      "source_summary": {
        "content": "Due to an influencer's controversial post causing backlash against our skincare campaign, we must immediately terminate their contract, assess the damage, issue a public apology, and secure a replacement influencer aligned with our brand values to salvage the campaign.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:3",
      "ordinal": 3,
      "source_summary": {
        "content": "The influencer involved is @ControversialInfluencer and our campaign hashtag is #GlowUpSkincare.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:6",
      "ordinal": 6,
      "source_summary": {
        "action": "{\"name\": \"getContentAnalytics\", \"arguments\": {\"analysisType\": \"engagement\", \"contentIds\": [\"post12345\"]}}",
        "role": "agent",
        "thought": "I'll call getContentAnalytics to retrieve detailed engagement metrics for the identified post as part of damage assessment."
      }
    },
    {
      "operation_id": "test:280:8",
      "ordinal": 8,
      "source_summary": {
        "action": "{\"name\": \"getContentAnalytics\", \"arguments\": {\"analysisType\": \"sentiment\", \"contentIds\": [\"post12345\"]}}",
        "role": "agent",
        "thought": "I'll call getContentAnalytics to retrieve detailed sentiment metrics for the identified post as part of the backlash damage assessment."
      }
    },
    {
      "operation_id": "test:280:12",
      "ordinal": 11,
      "source_summary": {
        "content": "We've gathered the termination details: creator ID CR789 for campaign CAMP456, withhold all outstanding payments, manager ID MGR123, legal approval code LEGAL_APPROVE_2023, and confirmation code CONFIRM_SAFE_TERM. We confirm the proposed termination reason regarding brand safety violations stands.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:13",
      "ordinal": 12,
      "source_summary": {
        "action": "{\"name\": \"terminateCreatorPartnership\", \"arguments\": {\"creatorId\": \"CR789\", \"campaignId\": \"CAMP456\", \"terminationType\": \"brand_safety\", \"reason\": \"Termination due to brand safety violations: influencer posted controversial content causing significant campaign backlash.\", \"outstandingPayments\": \"withhold_all\", \"managerId\": \"MGR123\", \"legalApproval\": \"LEGAL_APPROVE_2023\", \"confirmationCode\": \"CONFIRM_SAFE_TERM\"}}",
        "role": "agent",
        "thought": "I'll call terminateCreatorPartnership immediately using the provided termination details and confirmed reason to execute the contract termination as requested."
      }
    },
    {
      "operation_id": "test:280:16",
      "ordinal": 15,
      "source_summary": {
        "content": "We have the apology statement ready: \"We apologize for the recent controversy involving our campaign influencer. We've terminated the partnership and reaffirm our commitment to brand values.\" Please publish it on twitter and instagram via spokesperson SPOKE_789. PR approval code is PR_APPR_2023, legal review is pending, and confirmation code is APOLOGY_CONFIRM_789.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:20",
      "ordinal": 19,
      "source_summary": {
        "content": "For the replacement influencer search, we need candidates matching: query 'clean beauty skincare', platform Instagram, minimum 50,000 followers, category wellness, minimum 4.5% engagement rate, and limit 5 results.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:24",
      "ordinal": 23,
      "source_summary": {
        "content": "We have selected creator ID CR_DEF456 as the replacement influencer for the #GlowUpSkincare campaign.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:26",
      "ordinal": 25,
      "source_summary": {
        "content": "We are using email for outreach to contact@pureadvocate.com with the subject \"Urgent Collab Opportunity - GlowUpSkincare\" and the following body: We invite you to join our campaign promoting clean beauty values...",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:30",
      "ordinal": 29,
      "source_summary": {
        "content": "CR_DEF456 has accepted our collaboration offer for the #GlowUpSkincare campaign. We confirm their acceptance and are ready to proceed with contract signing.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:32",
      "ordinal": 31,
      "source_summary": {
        "content": "For the new campaign brief, we're using the campaign name \"GlowUp Recovery\". The strategic content will focus on brand safety and ingredient transparency... and the owner ID is MGR789.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:36",
      "ordinal": 35,
      "source_summary": {
        "content": "We have the contract details ready: a contract value of $15,000, exclusivity terms prohibiting competing skincare brands for 6 months, global perpetual usage rights across digital platforms, signing executive ID EXEC2023, legal approval code LEGAL_NEW_INFL_APPROVE, and confirmation code SIGN_CONFIRM_567.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:280:37",
      "ordinal": 36,
      "source_summary": {
        "action": "{\"name\": \"signInfluencerContract\", \"arguments\": {\"creatorId\": \"CR_DEF456\", \"campaignId\": \"CAMP456\", \"contractValue\": 15000, \"exclusivityTerms\": \"No competing skincare brands for 6 months\", \"usageRights\": \"Global perpetual use across digital\", \"signingExecutiveId\": \"EXEC2023\", \"legalApproval\": \"LEGAL_NEW_INFL_APPROVE\", \"confirmationCode\": \"SIGN_CONFIRM_567\"}}",
