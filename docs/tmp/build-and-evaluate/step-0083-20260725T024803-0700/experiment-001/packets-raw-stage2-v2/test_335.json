      "source_summary": {
        "content": "For the emergency broadcast, use the alert message: 'Security incident at Union Square. Services suspended.' with instructions: 'Use alternative shuttle buses at 5th Ave and Broadway' and 'Avoid the station area'. Broadcast on channels: app_push, station_pa, and digital_signs. Coordinator approval is EA-789 and broadcast confirmation code is BC-5567.",
        "role": "user"
      }
    },
