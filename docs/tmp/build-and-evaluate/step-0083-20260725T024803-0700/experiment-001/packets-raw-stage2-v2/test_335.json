      "source_summary": {
        "content": "There's a major security threat reported at Union Square station requiring immediate action. First, verify all incident details and identify affected transit routes, then suspend impacted services and alert passengers about alternatives, and finally compile evidence for the official report, sign the documentation for legal submission, and notify authorities about resolution.",
        "role": "user"
      }
    },
    {
