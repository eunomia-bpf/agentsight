  "selected_evidence": [
    {
      "operation_id": "test:290:1",
      "ordinal": 1,
      "source_summary": {
        "content": "We're opening a new UX Designer role in the Design team. Please create the headcount requisition and publish the job posting, then create a candidate profile for Emily Rodriguez, update her status to interview, and schedule her interview with the design leads. After the interview, record feedback and if positive, advance her to offer stage, generate the offer letter, route it for approval, and initiate background and reference checks.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:3",
      "ordinal": 3,
      "source_summary": {
        "content": "The salary band for the UX Designer role is $90,000-$110,000, and the hiring manager is John Smith.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:7",
      "ordinal": 7,
      "source_summary": {
        "content": "The requisition req123 for the UX Designer role has been approved. Please publish the job posting to our career site and LinkedIn.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:11",
      "ordinal": 11,
      "source_summary": {
        "content": "Emily Rodriguez's email is emily.rodriguez@example.com, she applied through our inbound channel, and her phone number is 555-1234.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:14",
      "ordinal": 14,
      "source_summary": {
        "action": "{\"name\": \"update_candidate_stage\", \"arguments\": {\"candidate_id\": \"cand456\", \"new_stage\": \"interview\"}}",
        "role": "agent",
        "thought": "I'll update the candidate stage to interview for Emily Rodriguez as requested by the user since we now have her candidate record."
      }
    },
    {
      "operation_id": "test:290:17",
      "ordinal": 17,
      "source_summary": {
        "content": "The interviewers are lead1 and lead2. Schedule Emily Rodriguez's interview on 2024-01-18 from 14:00 to 15:00 virtually.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:18",
      "ordinal": 18,
      "source_summary": {
        "action": "{\"name\": \"create_interview_schedule\", \"arguments\": {\"candidate_id\": \"cand456\", \"interviewer_ids\": [\"lead1\", \"lead2\"], \"start_time\": \"2024-01-18T14:00:00\", \"end_time\": \"2024-01-18T15:00:00\", \"mode\": \"Virtual\"}}",
        "role": "agent",
        "thought": "I'll schedule the interview for candidate cand456 with the provided interviewer IDs, start time, end time, and virtual mode as specified in the latest user message."
      }
    },
    {
      "operation_id": "test:290:21",
      "ordinal": 21,
      "source_summary": {
        "content": "The feedback for Emily Rodriguez is positive from all interviewers. They highlighted her strong design skills and excellent cultural fit.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:22",
      "ordinal": 22,
      "source_summary": {
        "action": "{\"name\": \"add_recruiter_note\", \"arguments\": {\"candidate_id\": \"cand456\", \"note\": \"Positive feedback from all interviewers. Strong design skills and cultural fit.\"}}",
        "role": "agent",
        "thought": "I'll add a recruiter note for candidate cand456 to record the positive interview feedback provided in the latest user message."
      }
    },
    {
      "operation_id": "test:290:24",
      "ordinal": 24,
      "source_summary": {
        "action": "{\"name\": \"update_candidate_stage\", \"arguments\": {\"candidate_id\": \"cand456\", \"new_stage\": \"offer\"}}",
        "role": "agent",
        "thought": "I'll update the candidate stage to offer since the interview feedback was positive as confirmed in the latest user message."
      }
    },
    {
      "operation_id": "test:290:27",
      "ordinal": 27,
      "source_summary": {
        "content": "For Emily Rodriguez, set her base salary to $100,000 with a start date of March 15, 2024. The approver IDs are mgr123 and mgr456, use the standard background check package, and send reference requests to ref1@example.com and ref2@example.com.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:290:28",
