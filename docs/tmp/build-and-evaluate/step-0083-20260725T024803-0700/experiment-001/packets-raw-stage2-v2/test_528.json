      "source_summary": {
        "content": "I confirm the alertType as service_emergency and affectedAreas as Central Station and Riverside Station. For the broadcast, set severity to critical, use alertMessage \"Emergency: Power outage on Blue Line between Central Station and Riverside Station. Service suspended.\", include instructions \"Seek alternative transportation\" and \"Check website for updates\", broadcastChannels as sms, app_push, station_pa, and digital_signs, dispatcherId DISP_4567, emergencyCoordinatorApproval AUTH_7890, and confirmationCode CFRM_1234.",
        "role": "user"
      }
    },
