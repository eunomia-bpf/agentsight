      "ordinal": 3,
      "source_summary": {
        "content": "The phishing URL is http://malicious.example.com/phish. We also have a file hash from the workstation: d41d8cd98f00b204e9800998ecf8427e with hash type MD5.",
        "role": "user"
      }
    },
    {
      "operation_id": "test:174:4",
      "ordinal": 4,
      "source_summary": {
