      }
    },
    {
      "operation_id": "test:312:9",
      "ordinal": 9,
      "source_summary": {
        "content": "I authorize the termination of operator OP_789 effective 2024-01-15 for misconduct causing the critical safety incident at Metro Center Station on the Blue Line, with evidence including incident report #789 and CCTV footage. For the line suspension, implement full closure with shuttle buses between Metro Center and Downtown as alternative service, confirmed under dispatcher DISP_101 and supervisor approval SA_202.",
        "role": "user"
      }
    },
