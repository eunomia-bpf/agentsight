toring with Trace Command\\n```bash\\n# Basic trace monitoring\\ncd collector && cargo run trace --ssl --process --comm python --server\\n\\n# Advanced trace with filtering\\ncd collector && cargo run trace --ssl-filter \\\"data.type=binary\\\" --http-filter \\\"request.method=","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"POST\\\\\\\" --server --log-file trace.log\\\\n\\\\n# Optimized agent\"}              }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"POST\\\" --server --log-file trace.log\\n\\n# Optimized agent","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\" recording\\\\ncd collector && cargo run record --comm claude --server-port 8\"} }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":" recording\\ncd collector && cargo run record --comm claude --server-port 8","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"080\\\\n```\"}   }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"080\\n```","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\"}\"} }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"\"}","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_stop\",\"index\":0  }","event":"content_block_stop","id":null,"parsed_data":{"index":0,"type":"content_block_stop"},"raw_dat