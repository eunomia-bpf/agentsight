nt-tracer/collector/src/framework/runners/agent.rs\",\"limit\":100},\"cache_control\":{\"type\":\"ephemeral\"}}]},{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017NWx8fVxRHnUpmpyNZsNBo\",\"type\":\"tool_result\",\"content\":\"     1→use super::{Runner, EventStream, RunnerError};\\n     2→use crate::framework::analyzers::Analyzer;\\n     3→use async_trait::async_trait;\\n     4→use futures::stream::select_all;\\n     5→\\n     6→/// AgentRunner composes multiple runners into a single unified stream\\n     7→/// with optional global analyzers applied to the merged stream\\n     8→pub struct AgentRunner {\\n     9→    runners: Vec<Box<dyn Runner>>,\\n    10→    analyzers: Vec<Box<dyn Analyzer>>,\\n    11→    name: String,\\n    12→}\\n    13→\\n    14→impl AgentRunner {\\n    15→    /// Create a new AgentRunner with the given name\\n    16→    pub fn new(name: impl Into<String>) -> Self {\\n    17→        Self {\\n    18→            runners: Vec::new(),\\n    19→            analyzers: Vec::new(),\\n    20→            name: name.into(),\\n    21→        }\\n    22→    }\\n    23→    \\n    24→    /// Add a pre-configured runner with its analyzer chain\\n    25→    pub fn add_runner(mut self, runner: Box<dyn Runner>) -> Self {\\n    26→        self.runners.push(runner);\\n    27→        self\\n    28→    }\\n    29→    \\n    30→    /// Add analyzer that will be applied to the merged stream\\n    31→    pub fn add_global_analyzer(mut self, analyzer: Box<dyn Analyzer>) -> Self {\\n    32→        self.analyzers.push(analyzer);\\n    33→        self\\n    34→    }\\n    35→    \\n    36→    /// Get the number of configured runners\\n    37→    pub fn runner_count(&self) -> usize {\\n    38→        self.runners.len()\\n    39→    }\\n    40→    \\n    41→    /// Get the number of configured global analyzers\\n    42→    pub fn analyzer_count(&self) -> usize {\\n    43→        self.analyzers.len()\\n    44→    }\\n    45→}\\n    46→\\n    47→#[async_trait]\\n    48→impl Runner for AgentRunner {\\n    49→    async fn run(&mut self) -> Result<EventStream, RunnerError> {\\n    50→        if self.runners.is_empty() {\\n    51→            return Err(\\\"No runners configured for AgentRunner\\\".into());\\n    52→        }\\n    53→        \\n    54→        // Start all runners concurrently and collect their streams\\n    55→        let mut streams = Vec::new();\\n    56→        for runner in &mut self.runners {\\n    57→            let stream = runner.run().await?;\\n    58→            streams.push(stream);\\n    59→        }\\n    60→        \\n    61→        // Merge all streams into a single stream\\n    62→        let merged_stream = select_all(streams);\\n    63→        \\n    64→        // Apply global analyzers to the merged stream\\n    65→        let mut final_stream = Box::pin(merged_stream) as EventStream;\\n    66→        for analyzer in &mut self.analyzers {\\n    67→            final_stream = analyzer.process(final_stream).await\\n    68→                .map_err(|e| format!(\\\"Global analyzer error: {}\\\", e))?;\\n    69→        }\\n    70→        \\n    71→        Ok(final_stream)\\n    72→    }\\n    73→    \\n    74→    fn add_analyzer(mut self, analyzer: Box<dyn Analyzer>) -> Self {\\n    75→        self.analyzers.push(analyzer);\\n    76→        self\\n    77→    }\\n    78→    \\n    79→    fn name(&self) -> &str {\\n    80→        &self.name\\n    81→    }\\n    82→    \\n    83→    fn id(&self) -> String {\\n    84→        format!(\\\"agent-{}\\\", self.name)\\n    85→    }\\n    86→}\\n    87→\\n    88→#[cfg(test)]\\n    89→mod tests {\\n    90→    use super::*;\\n    91→    use crate::framework::runners::FakeRunner;\\n    92→    use crate::framework::analyzers::{OutputAnalyzer, SSEProcessor, HTTPParser, FileLogger};\\n    93→    use futures::stream::StreamExt;\\n    94→    use tempfile::NamedTempFile;\\n    95→    use std::time::Duration;\\n    96→    use tokio::time::timeout;\\n    97→\\n    98→    #[tok