t error_event = event;\\n    77→                    if let Some(data) = error_event.data.as_object_mut() {\\n    78→                        data.insert(\\\"analyzer_error\\\".to_string(), json!(\\\"Simulated error\\\"));\\n    79→                    }\\n    80→                    error_event\\n    81→                } else {\\n    82→                    event\\n    83→                }\\n    84→            });\\n    85→            \\n    86→            Ok(Box::pin(processed_stream))\\n    87→        }\\n    88→\\n    89→        fn name(&self) -> &str {\\n    90→            \\\"ErrorSimulatorAnalyzer\\\"\\n    91→        }\\n    92→    }\\n    93→\\n    94→    /// Custom test analyzer that filters events\\n    95→    struct FilterAnalyzer {\\n    96→        filter_condition: String,\\n    97→    }\\n    98→\\n    99→    impl FilterAnalyzer {\\n   100→        fn new(filter_condition: String) -> Self {\\n   101→            Self { filter_condition }\\n   102→        }\\n   103→    }\\n   104→\\n   105→    #[async_trait]\\n   106→    impl Analyzer for FilterAnalyzer {\\n   107→        async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n   108→            let condition = self.filter_condition.clone();\\n   109→            let filtered_stream = stream.filter(move |event| {\\n   110→                let matches = if condition == \\\"ssl_only\\\" {\\n   111→                    event.source == \\\"ssl\\\"\\n   112→                } else if condition == \\\"even_pids\\\" {\\n   113→                    event.data.get(\\\"pid\\\")\\n   114→                        .and_then(|v| v.as_u64())\\n   115→                        .map(|pid| pid % 2 == 0)\\n   116→                        .unwrap_or(false)\\n   117→                } else {\\n   118→                    true // No filter\\n   119→                };\\n   120→                futures::future::ready(matches)\\n   121→            });\\n   122→            \\n   123→            Ok(Box::pin(filtered_stream))\\n   124→        }\\n   125→\\n   126→        fn name(&self) -> &str {\\n   127→            \\\"FilterAnalyzer\\\"\\n   128→        }\\n   129→    }\\n   130→\\n   131→    /// Custom test analyzer that adds metadata\\n   132→    struct MetadataEnricherAnalyzer {\\n   133→        metadata: serde_json::Value,\\n   134→    }\\n   135→\\n   136→    impl MetadataEnricherAnalyzer {\\n   137→        fn new(metadata: serde_json::Value) -> Self {\\n   138→            Self { metadata }\\n   139→        }\\n   140→    }\\n   141→\\n   142→    #[async_trait]\\n   143→    impl Analyzer for MetadataEnricherAnalyzer {\\n   144→        async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n   145→            let metadata = self.metadata.clone();\\n   146→            let enriched_stream = stream.map(move |mut event| {\\n   147→                if let Some(data) = event.data.as_object_mut() {\\n   148→                    data.insert(\\\"enriched_metadata\\\".to_string(), metadata.clone());\\n   149→                }\\n   150→                event\\n   151→            });\\n   152→            \\n   153→            Ok(Box::pin(enriched_stream))\\n   154→        }\\n   155→\\n   156→        fn name(&self) -> &str {\\n   157→            \\\"MetadataEnricherAnalyzer\\\"\\n   158→        }\\n   159→    }\\n   160→\\n   161→    #[tokio::test]\\n   162→    async fn test_complex_analyzer_chain_composition() {\\n   163→        let temp_file = NamedTempFile::new().unwrap();\\n   164→        \\n   165→        // Create a complex chain: Filter -> ChunkMerger -> Enrich -> FileLogger -> Output\\n   166→        let mut runner = FakeRunner::new()\\n   167→            .event_count(5) // 10 events total\\n   168→            .delay_ms(10)\\n   169→            .add_analyzer(Box::new(FilterAnalyzer::new(\\\"ssl_only\\\".to_string())))\\n   170→            .add_analyzer(Box::new(SSEProcessor::new_with_timeout(5000)))\\n   171→            .add_analyzer(Box::new(MetadataEnricherAnalyzer::new(json!({\\\"test_run\\\": \\\"complex_chain\\\", \\\"version\\\": \\\"1.0\\\"}))))\\n   172→            .add_analyzer(Box::new(FileLogger::new(temp_file.path()).unwrap()))\\n   173→            .add_analyzer(Box::new(OutputAnalyzer::new()));\\n   174→\\n   175→        let stream = runner.run().await.unwrap();\\n   176→        let events: Vec<_> = stream.collect().await;\\n   177→        \\n   178→        println!(\\\"Complex Chain Test Results:\\\");\\n   179→        println!(\\\"Total events: {}\\\", events.len());\\n   180→        \\n   181→        // Verify events passed through all analyzers\\n   182→        assert!(events.len() > 0, \\\"Should have events\\\");\\n   183→        \\n   184→        // All remaining events should be SSL (due to filter)\\n   185→        let non_ssl_events = events.iter().filter(|e| e.source != \\\"ssl\\\" && e.source != \\\"sse_processor\\\").count();\\n   186→        assert_eq!(non_ssl_events, 0, \\\"Filter should remove non-SSL events\\\");\\n   187→        \\n   188→        // Events should have enriched metadata\\n   189→        let enriched_events = events.iter()\\n   190→            .filter(|e| e.data.get(\\\"enriched_metadata\\\").is_some())\\n   191→            .count();\\n   192→        assert!(enriched_events > 0, \\\"Should have enriched events\\\");\\n   193→        \\n   194→        // Verify sse processor events were created\\n   195→        let _sse_events = events.iter()\\n   196→            .filter(|e| e.source == \\\"sse_processor\\\")\\n   197→            .count();\\n   198→        // Note: sse_events might be 0 if no SSE data was processed\\n   199→        \\n   200→        // Verify file was written\\n   201→        let file_size = std::fs::metadata(temp_file.path()).unwrap().len();\\n   202→        assert!(file_size > 0, \\\"Log file should have content\\\");\\n   203→        \\n   204→        println!(\\\"✅ Complex analyzer chain composition test completed!\\\");\\n   205→    }\\n   206→\\n   207→    #[tokio::test]\\n   208→    async fn test_analyzer_chain_error_resilience() {\\n   209→        // Test that analyzer chain continues working even when individual analyzers encounter issues\\n   210→        let mut runner = FakeRunner::new()\\n   211→            .event_count(5)\\n   212→            .delay_ms(10)\\n   213→            .add_analyzer(Box::new(ErrorSimulatorAnalyzer::new(3))) // Error on 3rd event\\n   214→            .add_analyzer(Box::new(SSEProcessor::new_with_timeout(5000)))\\n   215→            .add_analyzer(Box::new(OutputAnalyzer::new()));\\n   216→\\n   217→        let stream = runner.run().await.unwrap();\\n   218→        let events: Vec<_> = stream.collect().await;\\n   219→        \\n   220→        println!(\\\"Error Resilience Test Results:\\\");\\n   221→        println!(\\\"Total events: {}\\\", events.len());\\n   222→        \\n   223→        // Should still process all events\\n   224→        assert!(events.len() >= 10, \\\"Should process all events despite simulated error\\\");\\n   225→        \\n   226→        // Check that error was marked on the 3rd event\\n   227→        let error_events = events.iter()\\n   228→            .filter(|e| e.data.get(\\\"analyzer_error\\\").is_some())\\n   229→            .count();\\n   230→        assert!(error_events > 0, \\\"Should have error markers from ErrorSimulator\\\");\\n   231→        \\n   232→        println!(\\\"✅ Error resilience test completed!\\\");\\n   233→    }\\n   234→\\n   235→    #[tokio::test]\\n   236→    async fn test_analyzer_chain_concurrent_processing() {\\n   237→        use std::sync::Arc;\\n   238→        use tokio::sync::Mutex;\\n   239→        \\n   240→        // Test multiple analyzer chains running concurrently\\n   241→        let results = Arc::new(Mutex::new(Vec::new()));\\n   242→        \\n   243→        let mut handles = Vec::new();\\n   244→        \\n   245→        for i in 0..3 {\\n   246→            let results_clone = Arc::clone(&results);\\n   247→            let handle = tokio::spawn(async move {\\n   248→                let mut runner = FakeRunner::new()\\n   249→                    .event_count(3)\\n   250→                    .delay_ms(5)\\n   251→                    .add_analyzer(Box::new(SSEProcessor::new_with_timeout(5000)))\\n   252→                    .add_analyzer(Box::new(OutputAnalyzer::new()));\\n   253→\\n   254→                let stream = runner.run().await.unwrap();\\n   255→                let events: Vec<_> = stream.collect().await;\\n   256→                \\n   257→                let mut results_guard = results_clone.lock().await;\\n   258→                results_guard.push((i, events.len()));\\n   259→                \\n   260→                events.len()\\n   261→            });\\n   262→            handles.push(handle);\\n   263→        }\\n   264→        \\n   265→        // Wait for all chains to complete\\n   266→        let mut total_events = 0;\\n   267→        for handle in handles {\\n   268→            total_events += handle.await.unwrap();\\n   269→        }\\n   270→        \\n   271→        let results_guard = results.lock().await;\\n   272→        \\n   273→        println!(\\\"Concurrent Processing Test Results:\\\");\\n   274→        println!(\\\"Total events across all chains: {}\\\", total_events);\\n   275→        println!(\\\"Individual chain results: {:?}\\\", *results_guard);\\n   276→        \\n   277→        // All chains should have processed events\\n   278→        assert_eq!(results_guard.len(), 3, \\\"Should have 3 chain results\\\");\\n   279→        assert!(total_events >= 18, \\\"Should have at least 18 events total (3 chains × 6 events)\\\");\\n   280→        \\n   281→        for (chain_id, event_count) in results_guard.iter() {\\n   282→            assert!(*event_count >= 6, \\\"Chain {} should have at least 6 events\\\", chain_id);\\n   283→        }\\n   284→        \\n   285→        println!(\\\"✅ Concurrent processing test completed!\\\");\\n   286→    }\\n   287→\\n   288→    #[tokio::test]\\n   289→    async fn test_analyzer_chain_streaming_behavior() {\\n   290→        // Test that events are processed in streaming fashion, not batched\\n   291→        use std::sync::Arc;\\n   292→        use tokio::sync::Mutex;\\n   293→        use std::time::Instant;\\n   294→        \\n   295→        let event_timestamps = Arc::new(Mutex::new(Vec::new()));\\n   296→        \\n   297→        // Custom analyzer that records processing timestamps\\n   298→        struct TimestampRecorderAnalyzer {\\n   299→            timestamps: Arc<Mutex<Vec<(usize, Instant)>>>,\\n   300→            counter: Arc<AtomicUsize>,\\n   301→        }\\n   302→        \\n   303→        impl TimestampRecorderAnalyzer {\\n   304→            fn new(timestamps: Arc<Mutex<Vec<(usize, Instant)>>>) -> Self {\\n   305→                Self {\\n   306→                    timestamps,\\n   307→                    counter: Arc::new(AtomicUsize::new(0)),\\n   308→                }\\n   309→            }\\n   310→        }\\n   311→        \\n   312→        #[async_trait]\\n   313→        impl Analyzer for TimestampRecorderAnalyzer {\\n   314→            async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n   315→                let timestamps = self.timestamps.clone();\\n   316→                let counter = self.counter.clone();\\n   317→                \\n   318→                let recorded_stream = stream.map(move |event| {\\n   319→                    let count = counter.fetch_add(1, Ordering::SeqCst);\\n   320→                    let timestamp = Instant::now();\\n   321→                    \\n   322→                    let timestamps_clone = timestamps.clone();\\n   323→                    tokio::spawn(async move {\\n   324→                        let mut guard = timestamps_clone.lock().await;\\n   325→                        guard.push((count, timestamp));\\n   326→                    });\\n   327→                    \\n   328→                    event\\n   329→                });\\n   330→                \\n   331→                Ok(Box::pin(recorded_stream))\\n   332→            }\\n   333→            \\n   334→            fn name(&self) -> &str {\\n   335→                \\\"TimestampRecorderAnalyzer\\\"\\n   336→            }\\n   337→        }\\n   338→        \\n   339→        let timestamps_clone = Arc::clone(&event_timestamps);\\n   340→        \\n   341→        let mut runner = FakeRunner::new()\\n   342→            .event_count(5) // 10 events total\\n   343→            .delay_ms(100) // 100ms delay to ensure streaming behavior is observable\\n   344→            .add_analyzer(Box::new(TimestampRecorderAnalyzer::new(timestamps_clone)))\\n   345→            .add_analyzer(Box::new(OutputAnalyzer::new()));\\n   346→\\n   347→        let start_time = Instant::now();\\n   348→        let stream = runner.run().await.unwrap();\\n   349→        let events: Vec<_> = stream.collect().await;\\n   350→        let total_time = start_time.elapsed();\\n   351→        \\n   352→        // Wait a bit for async timestamp recording to complete\\n   353→        tokio::time::sleep(Duration::from_millis(50)).await;\\n   354→        \\n   355→        let timestamps_guard = event_timestamps.lock().await;\\n   356→        \\n   357→        println!(\\\"Streaming Behavior Test Results:\\\");\\n   358→        println!(\\\"Total events: {}\\\", events.len());\\n   359→        println!(\\\"Total time: {:?}\\\", total_time);\\n   360→        println!(\\\"Recorded timestamps: {}\\\", timestamps_guard.len());\\n   361→        \\n   362→        // Verify streaming behavior - events should arrive over time, not all at once\\n   363→        assert!(timestamps_guard.len() >= 5, \\\"Should have recorded multiple timestamps\\\");\\n   364→        \\n   365→        if timestamps_guard.len() >= 2 {\\n   366→            let first_event_time = timestamps_guard[0].1;\\n   367→            let last_event_time = timestamps_guard[timestamps_guard.len() - 1].1;\\n   368→            let processing_span = last_event_time.duration_since(first_event_time);\\n   369→            \\n   370→            println!(\\\"Processing span: {:?}\\\", processing_span);\\n   371→            \\n   372→            // Should take some time due to delays, indicating streaming behavior\\n   373→            assert!(processing_span >= Duration::from_millis(50), \\n   374→                \\\"Events should be processed over time, not all at once\\\");\\n   375→        }\\n   376→        \\n   377→        println!(\\\"✅ Streaming behavior test completed!\\\");\\n   378→    }\\n   379→\\n   380→    #[tokio::test]\\n   381→    async fn test_analyzer_chain_backpressure_handling() {\\n   382→        // Test analyzer chain behavior under backpressure conditions\\n   383→        \\n   384→        // Custom slow analyzer that simulates processing delays\\n   385→        struct SlowAnalyzer {\\n   386→            delay_ms: u64,\\n   387→        }\\n   388→        \\n   389→        impl SlowAnalyzer {\\n   390→            fn new(delay_ms: u64) -> Self {\\n   391→                Self { delay_ms }\\n   392→            }\\n   393→        }\\n   394→        \\n   395→        #[async_trait]\\n   396→        impl Analyzer for SlowAnalyzer {\\n   397→            async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n   398→                let delay = self.delay_ms;\\n   399→                let slow_stream = stream.then(move |event| async move {\\n   400→                    tokio::time::sleep(Duration::from_millis(delay)).await;\\n   401→                    event\\n   402→                });\\n   403→                \\n   404→                Ok(Box::pin(slow_stream))\\n   405→            }\\n   406→            \\n   407→            fn name(&self) -> &str {\\n   408→                \\\"SlowAnalyzer\\\"\\n   409→            }\\n   410→        }\\n   411→        \\n   412→        let start_time = Instant::now();\\n   413→        \\n   414→        let mut runner = FakeRunner::new()\\n   415→            .event_count(3) // 6 events total\\n   416→            .delay_ms(10) // Fast generation\\n   417→            .add_analyzer(Box::new(SlowAnalyzer::new(50))) // Slow processing\\n   418→            .add_analyzer(Box::new(OutputAnalyzer::new()));\\n   419→\\n   420→        let stream = runner.run().await.unwrap();\\n   421→        let events: Vec<_> = stream.collect().await;\\n   422→        let total_time = start_time.elapsed();\\n   423→        \\n   424→        println!(\\\"Backpressure Test Results:\\\");\\n   425→        println!(\\\"Total events: {}\\\", events.len());\\n   426→        println!(\\\"Total time: {:?}\\\", total_time);\\n   427→        \\n   428→        // Should process all events\\n   429→        assert_eq!(events.len(), 6, \\\"Should process all events despite slow analyzer\\\");\\n   430→        \\n   431→        // Should take longer due to slow analyzer (at least 3 * 50ms = 150ms for processing)\\n   432→        assert!(total_time >= Duration::from_millis(100), \\n   433→            \\\"Should take time due to slow analyzer processing\\\");\\n   434→        \\n   435→        println!(\\\"✅ Backpressure handling test completed!\\\");\\n   436→    }\\n   437→\\n   438→    #[tokio::test]\\n   439→    async fn test_analyzer_chain_resource_cleanup() {\\n   440→        // Test that resources are properly cleaned up after analyzer chain completion\\n   441→        use std::sync::Arc;\\n   442→        use tokio::sync::Mutex;\\n   443→        \\n   444→        // Custom analyzer that tracks resource allocation/cleanup\\n   445→        struct ResourceTrackingAnalyzer {\\n   446→            resources: Arc<Mutex<Vec<String>>>,\\n   447→            id: String,\\n   448→        }\\n   449→        \\n   450→        impl ResourceTrackingAnalyzer {\\n   451→            fn new(id: String, resources: Arc<Mutex<Vec<String>>>) -> Self {\\n   452→                Self { resources, id }\\n   453→            }\\n   454→        }\\n   455→        \\n   456→        impl Drop for ResourceTrackingAnalyzer {\\n   457→            fn drop(&mut self) {\\n   458→                // Simulate resource cleanup\\n   459→                println!(\\\"Cleaning up ResourceTrackingAnalyzer: {}\\\", self.id);\\n   460→            }\\n   461→        }\\n   462→        \\n   463→        #[async_trait]\\n   464→        impl Analyzer for ResourceTrackingAnalyzer {\\n   465→            async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n   466→                let resources = self.resources.clone();\\n   467→                let id = self.id.clone();\\n   468→                \\n   469→                // Simulate resource allocation\\n   470→                {\\n   471→                    let mut guard = resources.lock().await;\\n   472→                    guard.push(format!(\\\"resource_{}\\\", id));\\n   473→                }\\n   474→                \\n   475→                let processed_stream = stream.map(move |event| {\\n   476→                    // Simulate resource usage\\n   477→                    event\\n   478→                });\\n   479→                \\n   480→                Ok(Box::pin(processed_stream))\\n   481→            }\\n   482→            \\n   483→            fn name(&self) -> &str {\\n   484→                \\\"ResourceTrackingAnalyzer\\\"\\n   485→            }\\n   486→        }\\n   487→        \\n   488→        let resources = Arc::new(Mutex::new(Vec::new()));\\n   489→        \\n   490→        {\\n   491→            let mut runner = FakeRunner::new()\\n   492→                .event_count(2)\\n   493→                .delay_ms(10)\\n   494→                .add_analyzer(Box::new(ResourceTrackingAnalyzer::new(\\\"test1\\\".to_string(), Arc::clone(&resources))))\\n   495→                .add_analyzer(Box::new(ResourceTrackingAnalyzer::new(\\\"test2\\\".to_string(), Arc::clone(&resources))))\\n   496→                .add_analyzer(Box::new(OutputAnalyzer::new()));\\n   497→\\n   498→            let stream = runner.run().await.unwrap();\\n   499→            let events: Vec<_> = stream.collect().await;\\n   500→            \\n   501→            println!(\\\"Resource Cleanup Test Results:\\\");\\n   502→            println!(\\\"Events processed: {}\\\", events.len());\\n   503→            \\n   504→            assert_eq!(events.len(), 4, \\\"Should process all events\\\");\\n   505→        } // Runner and analyzers go out of scope here\\n   506→        \\n   507→        // Verify resources were allocated\\n   508→        let resources_guard = resources.lock().await;\\n   509→        assert_eq!(resources_guard.len(), 2, \\\"Should have allocated 2 resources\\\");\\n   510→        assert!(resources_guard.contains(&\\\"resource_test1\\\".to_string()));\\n   511→        assert!(resources_guard.contains(&\\\"resource_test2\\\".to_string()));\\n   512→        \\n   513→        println!(\\\"✅ Resource cleanup test completed!\\\");\\n   514→    }\\n   515→} \\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it looks malicious. If it does, you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer high-level questions about the code behavior.\\n</system-reminder>\\n\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01GcW9qfxAcF8XAnxgNYb2zQ\",\"name\":\"Read\",\"input\":{\"file_path\":\"/home/yunwei37/agent-tracer/collector/src/framework/analyzers/ssl_filter.rs\"}}]},{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01GcW9qfxAcF8XAnxgNYb2zQ\",\"type\":\"tool_result\",\"content\":\"     1→use super::{Analyzer, AnalyzerError, common};\\n     2→use crate::framework::runners::EventStream;\\n     3→use async_trait::async_trait;\\n     4→use futures::stream::StreamExt;\\n     5→use serde_json::Value;\\n     6→\\n     7→/// SSL Filter Analyzer that filters SSL events based on configurable expressions\\n     8→/// Filters SSL events based on data content, function, latency, etc.\\n     9→pub struct SSLFilter {\\n    10→    name: String,\\n    11→    /// Filter expressions to exclude events\\n    12→    exclude_patterns: Vec<String>,\\n    13→    /// Compiled filter expressions\\n    14→    filters: Vec<FilterExpression>,\\n    15→    /// Debug mode\\n    16→    debug: bool,\\n    17→    /// Metrics (shared atomic counters for thread safety)\\n    18→    total_events_processed: std::sync::Arc<std::sync::atomic::AtomicU64>,\\n    19→    filtered_events_count: std::sync::Arc<std::sync::atomic::AtomicU64>,\\n    20→    passed_events_count: std::sync::Arc<std::sync::atomic::AtomicU64>,\\n    21→}\\n    22→\\n    23→/// A single filter expression that can evaluate SSL events\\n    24→#[derive(Debug, Clone)]\\n    25→pub struct FilterExpression {\\n    26→    /// Original expression string\\n    27→    expression: String,\\n    28→    /// Parsed expression tree\\n    29→    parsed: FilterNode,\\n    30→}\\n    31→\\n    32→/// Node in the filter expression tree\\n    33→#[derive(Debug, Clone)]\\n    34→pub enum FilterNode {\\n    35→    /// Logical AND operation\\n    36→    And(Box<FilterNode>, Box<FilterNode>),\\n    37→    /// Logical OR operation\\n    38→    Or(Box<FilterNode>, Box<FilterNode>),\\n    39→    /// Single condition check\\n    40→    Condition {\\n    41→        field: String,        // Field name (e.g., \\\"data\\\", \\\"function\\\", \\\"latency_ms\\\")\\n    42→        operator: String,     // Operator (exact, prefix, suffix, contains, gt, lt, gte, lte)\\n    43→        value: String,        // Expected value\\n    44→    },\\n    45→    /// Empty filter (matches nothing)\\n    46→    Empty,\\n    47→}\\n    48→\\n    49→impl SSLFilter {\\n    50→    /// Create a new SSL filter with no patterns (passes everything through)\\n    51→    pub fn new() -> Self {\\n    52→        SSLFilter {\\n    53→            name: \\\"SSLFilter\\\".to_string(),\\n    54→            exclude_patterns: Vec::new(),\\n    55→            filters: Vec::new(),\\n    56→            debug: false,\\n    57→            total_events_processed: std::sync::Arc::new(std::sync::atomic::AtomicU64::new(0)),\\n    58→            filtered_events_count: std::sync::Arc::new(std::sync::atomic::AtomicU64::new(0)),\\n    59→            passed_events_count: std::sync::Arc::new(std::sync::atomic::AtomicU64::new(0)),\\n    60→        }\\n    61→    }\\n    62→\\n    63→    /// Create a new SSL filter with exclude patterns\\n    64→    pub fn with_patterns(patterns: Vec<String>) -> Self {\\n    65→        let mut filter = SSLFilter::new();\\n    66→        filter.exclude_patterns = patterns.clone();\\n    67→        filter.filters = patterns.into_iter()\\n    68→            .map(|p| FilterExpression::parse(&p))\\n    69→            .collect();\\n    70→        filter\\n    71→    }\\n    72→\\n    73→\\n    74→\\n    75→\\n    76→\\n    77→}\\n    78→\\n    79→\\n    80→impl FilterExpression {\\n    81→    /// Parse a filter expression string\\n    82→    pub fn parse(expression: &str) -> Self {\\n    83→        let parsed = Self::parse_expression(expression);\\n    84→        FilterExpression {\\n    85→            expression: expression.to_string(),\\n    86→            parsed,\\n    87→        }\\n    88→    }\\n    89→\\n    90→    /// Parse an expression string into a FilterNode tree\\n    91→    fn parse_expression(expr: &str) -> FilterNode {\\n    92→        let expr = expr.trim();\\n    93→        \\n    94→        if expr.is_empty() {\\n    95→            return FilterNode::Empty;\\n    96→        }\\n    97→\\n    98→        // Handle OR operations (lowest precedence)\\n    99→        if let Some(or_pos) = Self::find_operator(expr, '|') {\\n   100→            let left = Self::parse_expression(&expr[..or_pos]);\\n   101→            let right = Self::parse_expression(&expr[or_pos + 1..]);\\n   102→            return FilterNode::Or(Box::new(left), Box::new(right));\\n   103→        }\\n   104→\\n   105→        // Handle AND operations (higher precedence)\\n   106→        if let Some(and_pos) = Self::find_operator(expr, '&') {\\n   107→            let left = Self::parse_expression(&expr[..and_pos]);\\n   108→            let right = Self::parse_expression(&expr[and_pos + 1..]);\\n   109→            return FilterNode::And(Box::new(left), Box::new(right));\\n   110→        }\\n   111→\\n   112→        // Parse single condition\\n   113→        Self::parse_condition(expr)\\n   114→    }\\n   115→\\n   116→    /// Find the position of an operator at the top level (not inside parentheses)\\n   117→    fn find_operator(expr: &str, op: char) -> Option<usize> {\\n   118→        let mut paren_depth = 0;\\n   119→        let chars: Vec<char> = expr.chars().collect();\\n   120→        \\n   121→        for (i, &c) in chars.iter().enumerate() {\\n   122→            match c {\\n   123→                '(' => paren_depth += 1,\\n   124→                ')' => paren_depth -= 1,\\n   125→                _ if c == op && paren_depth == 0 => return Some(i),\\n   126→                _ => {}\\n   127→            }\\n   128→        }\\n   129→        None\\n   130→    }\\n   131→\\n   132→    /// Parse a single condition like \\\"data=0\\\\r\\\\n\\\\r\\\\n\\\" or \\\"function=READ/RECV\\\"\\n   133→    fn parse_condition(expr: &str) -> FilterNode {\\n   134→        let expr = expr.trim();\\n   135→        \\n   136→        // Handle parentheses\\n   137→        if expr.starts_with('(') && expr.ends_with(')') {\\n   138→            return Self::parse_expression(&expr[1..expr.len()-1]);\\n   139→        }\\n   140→\\n   141→        // Find the operator\\n   142→        let operators = [\\\">=\\\", \\\"<=\\\", \\\"!=\\\", \\\"=\\\", \\\">\\\", \\\"<\\\", \\\"~\\\"];\\n   143→        \\n   144→        for &op in &operators {\\n   145→            if let Some(pos) = expr.find(op) {\\n   146→                let field = expr[..pos].trim().to_string();\\n   147→                let value = expr[pos + op.len()..].trim().to_string();\\n   148→                \\n   149→                let operator = match op {\\n   150→                    \\\"=\\\" => \\\"exact\\\",\\n   151→                    \\\"!=\\\" => \\\"not_equal\\\",\\n   152→                    \\\">\\\" => \\\"gt\\\",\\n   153→                    \\\"<\\\" => \\\"lt\\\", \\n   154→                    \\\">=\\\" => \\\"gte\\\",\\n   155→                    \\\"<=\\\" => \\\"lte\\\",\\n   156→                    \\\"~\\\" => \\\"contains\\\",\\n   157→                    _ => \\\"exact\\\",\\n   158→                }.to_string();\\n   159→\\n   160→                // Process escape sequences in the value\\n   161→                let processed_value = Self::process_escape_sequences(&value);\\n   162→                return FilterNode::Condition { field, operator, value: processed_value };\\n   163→            }\\n   164→        }\\n   165→\\n   166→        FilterNode::Empty\\n   167→    }\\n   168→\\n   169→    /// Process escape sequences in filter values\\n   170→    fn process_escape_sequences(value: &str) -> String {\\n   171→        let mut result = String::new();\\n   172→        let mut chars = value.chars().peekable();\\n   173→        \\n   174→        while let Some(ch) = chars.next() {\\n   175→            if ch == '\\\\\\\\' {\\n   176→                if let Some(&next_ch) = chars.peek() {\\n   177→                    match next_ch {\\n   178→                        'r' => {\\n   179→                            chars.next(); // consume the 'r'\\n   180→                            result.push('\\\\r');\\n   181→                        }\\n   182→                        'n' => {\\n   183→                            chars.next(); // consume the 'n'\\n   184→                            result.push('\\\\n');\\n   185→                        }\\n   186→                        't' => {\\n   187→                            chars.next(); // consume the 't'\\n   188→                            result.push('\\\\t');\\n   189→                        }\\n   190→                        '\\\\\\\\' => {\\n   191→                            chars.next(); // consume the second '\\\\'\\n   192→                            result.push('\\\\\\\\');\\n   193→                        }\\n   194→                        '\\\"' => {\\n   195→                            chars.next(); // consume the '\\\"'\\n   196→                            result.push('\\\"');\\n   197→                        }\\n   198→                        _ => {\\n   199→                            // Keep the backslash for unknown escape sequences\\n   200→                            result.push(ch);\\n   201→                        }\\n   202→                    }\\n   203→                } else {\\n   204→                    // Backslash at end of string\\n   205→                    result.push(ch);\\n   206→                }\\n   207→            } else {\\n   208→                result.push(ch);\\n   209→            }\\n   210→        }\\n   211→        \\n   212→        result\\n   213→    }\\n   214→\\n   215→    /// Evaluate this filter expression against SSL event data\\n   216→    pub fn evaluate(&self, data: &Value) -> bool {\\n   217→        self.evaluate_node(&self.parsed, data)\\n   218→    }\\n   219→\\n   220→    /// Evaluate a filter node against SSL event data\\n   221→    fn evaluate_node(&self, node: &FilterNode, data: &Value) -> bool {\\n   222→        match node {\\n   223→            FilterNode::And(left, right) => {\\n   224→                self.evaluate_node(left, data) && self.evaluate_node(right, data)\\n   225→            }\\n   226→            FilterNode::Or(left, right) => {\\n   227→                self.evaluate_node(left, data) || self.evaluate_node(right, data)\\n   228→            }\\n   229→            FilterNode::Condition { field, operator, value } => {\\n   230→                self.evaluate_condition(field, operator, value, data)\\n   231→            }\\n   232→            FilterNode::Empty => false,\\n   233→        }\\n   234→    }\\n   235→\\n   236→\\n   237→    /// Evaluate a single condition against SSL event data\\n   238→    fn evaluate_condition(&self, field: &str, operator: &str, expected: &str, data: &Value) -> bool {\\n   239→        // Handle special data.type field\\n   240→        if field == \\\"data.type\\\" {\\n   241→            if let Some(data_value) = data.get(\\\"data\\\").and_then(|v| v.as_str()) {\\n   242→                let detected_type = common::detect_data_type(data_value);\\n   243→                return self.compare_strings(detected_type, operator, expected);\\n   244→            }\\n   245→            return false;\\n   246→        }\\n   247→\\n   248→        // Get the field value from SSL event data\\n   249→        let field_value = match field {\\n   250→            \\\"data\\\" => data.get(\\\"data\\\").and_then(|v| v.as_str()),\\n   251→            \\\"function\\\" => data.get(\\\"function\\\").and_then(|v| v.as_str()),\\n   252→            \\\"comm\\\" => data.get(\\\"comm\\\").and_then(|v| v.as_str()),\\n   253→            \\\"is_handshake\\\" => return data.get(\\\"is_handshake\\\").and_then(|v| v.as_bool()).unwrap_or(false) == (expected == \\\"true\\\"),\\n   254→            \\\"truncated\\\" => return data.get(\\\"truncated\\\").and_then(|v| v.as_bool()).unwrap_or(false) == (expected == \\\"true\\\"),\\n   255→            \\\"len\\\" | \\\"pid\\\" | \\\"tid\\\" | \\\"uid\\\" => {\\n   256→                if let Some(num_val) = data.get(field).and_then(|v| v.as_u64()) {\\n   257→                    return self.compare_numbers(num_val, operator, expected);\\n   258→                }\\n   259→                return false;\\n   260→            }\\n   261→            \\\"latency_ms\\\" => {\\n   262→                if let Some(float_val) = data.get(\\\"latency_ms\\\").and_then(|v| v.as_f64()) {\\n   263→                    return self.compare_floats(float_val, operator, expected);\\n   264→                }\\n   265→                return false;\\n   266→            }\\n   267→            \\\"timestamp_ns\\\" => {\\n   268→                if let Some(timestamp) = data.get(\\\"timestamp_ns\\\").and_then(|v| v.as_u64()) {\\n   269→                    return self.compare_numbers(timestamp, operator, expected);\\n   270→                }\\n   271→                return false;\\n   272→            }\\n   273→            _ => None,\\n   274→        };\\n   275→\\n   276→        if let Some(value) = field_value {\\n   277→            self.compare_strings(value, operator, expected)\\n   278→        } else {\\n   279→            false\\n   280→        }\\n   281→    }\\n   282→\\n   283→    /// Compare string values based on operator\\n   284→    fn compare_strings(&self, actual: &str, operator: &str, expected: &str) -> bool {\\n   285→        match operator {\\n   286→            \\\"exact\\\" => actual == expected,\\n   287→            \\\"not_equal\\\" => actual != expected,\\n   288→            \\\"contains\\\" => actual.contains(expected),\\n   289→            \\\"prefix\\\" => actual.starts_with(expected),\\n   290→            \\\"suffix\\\" => actual.ends_with(expected),\\n   291→            _ => false,\\n   292→        }\\n   293→    }\\n   294→\\n   295→    /// Compare numeric values based on operator\\n   296→    fn compare_numbers(&self, actual: u64, operator: &str, expected: &str) -> bool {\\n   297→        if let Ok(expected_num) = expected.parse::<u64>() {\\n   298→            match operator {\\n   299→                \\\"exact\\\" => actual == expected_num,\\n   300→                \\\"not_equal\\\" => actual != expected_num,\\n   301→                \\\"gt\\\" => actual > expected_num,\\n   302→                \\\"lt\\\" => actual < expected_num,\\n   303→                \\\"gte\\\" => actual >= expected_num,\\n   304→                \\\"lte\\\" => actual <= expected_num,\\n   305→                _ => false,\\n   306→            }\\n   307→        } else {\\n   308→            false\\n   309→        }\\n   310→    }\\n   311→\\n   312→    /// Compare float values based on operator\\n   313→    fn compare_floats(&self, actual: f64, operator: &str, expected: &str) -> bool {\\n   314→        if let Ok(expected_num) = expected.parse::<f64>() {\\n   315→            match operator {\\n   316→                \\\"exact\\\" => (actual - expected_num).abs() < f64::EPSILON,\\n   317→                \\\"not_equal\\\" => (actual - expected_num).abs() >= f64::EPSILON,\\n   318→                \\\"gt\\\" => actual > expected_num,\\n   319→                \\\"lt\\\" => actual < expected_num,\\n   320→                \\\"gte\\\" => actual >= expected_num,\\n   321→                \\\"lte\\\" => actual <= expected_num,\\n   322→                _ => false,\\n   323→            }\\n   324→        } else {\\n   325→            false\\n   326→        }\\n   327→    }\\n   328→}\\n   329→\\n   330→#[async_trait]\\n   331→impl Analyzer for SSLFilter {\\n   332→    async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n   333→        let filters = self.filters.clone();\\n   334→        let debug = self.debug;\\n   335→        \\n   336→        // Clone the shared atomic counters for use in the stream\\n   337→        let total_counter = self.total_events_processed.clone();\\n   338→        let filtered_counter = self.filtered_events_count.clone();\\n   339→        let passed_counter = self.passed_events_count.clone();\\n   340→        \\n   341→        let filtered_stream = stream.filter_map(move |event| {\\n   342→            let filters = filters.clone();\\n   343→            let total_counter = total_counter.clone();\\n   344→            let filtered_counter = filtered_counter.clone();\\n   345→            let passed_counter = passed_counter.clone();\\n   346→            \\n   347→            async move {\\n   348→                // Increment total events processed\\n   349→                total_counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\\n   350→                \\n   351→                // Check if this is an SSL event and should be filtered\\n   352→                let should_filter = if filters.is_empty() {\\n   353→                    false\\n   354→                } else if event.source != \\\"ssl\\\" {\\n   355→                    false\\n   356→                } else {\\n   357→                    // Evaluate each filter expression\\n   358→                    let mut filtered = false;\\n   359→                    for filter in &filters {\\n   360→                        if filter.evaluate(&event.data) {\\n   361→                            if debug {\\n   362→                                eprintln!(\\\"[SSLFilter DEBUG] Event filtered by: {}\\\", filter.expression);\\n   363→                            }\\n   364→                            filtered = true;\\n   365→                            break;\\n   366→                        }\\n   367→                    }\\n   368→                    filtered\\n   369→                };\\n   370→\\n   371→                if should_filter {\\n   372→                    // Increment filtered counter\\n   373→                    filtered_counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\\n   374→                    None // Filter out\\n   375→                } else {\\n   376→                    // Increment passed counter  \\n   377→                    passed_counter.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\\n   378→                    Some(event) // Pass through\\n   379→                }\\n   380→            }\\n   381→        });\\n   382→\\n   383→        Ok(Box::pin(filtered_stream))\\n   384→    }\\n   385→\\n   386→    fn name(&self) -> &str {\\n   387→        &self.name\\n   388→    }\\n   389→}\\n   390→\\n   391→impl Drop for SSLFilter {\\n   392→    fn drop(&mut self) {\\n   393→        // Update global metrics when filter is dropped\\n   394→        let total = self.total_events_processed.load(std::sync::atomic::Ordering::Relaxed);\\n   395→        let filtered = self.filtered_events_count.load(std::sync::atomic::Ordering::Relaxed);\\n   396→        let passed = self.passed_events_count.load(std::sync::atomic::Ordering::Relaxed);\\n   397→        \\n   398→        update_global_ssl_metrics(total, filtered, passed);\\n   399→    }\\n   400→}\\n   401→\\n   402→#[cfg(test)]\\n   403→mod tests {\\n   404→    use super::*;\\n   405→    use serde_json::json;\\n   406→\\n   407→    #[test]\\n   408→    fn test_ssl_filter_expression_parsing() {\\n   409→        let expr = FilterExpression::parse(\\\"function=READ/RECV\\\");\\n   410→        match expr.parsed {\\n   411→            FilterNode::Condition { field, operator, value } => {\\n   412→                assert_eq!(field, \\\"function\\\");\\n   413→                assert_eq!(operator, \\\"exact\\\");\\n   414→                assert_eq!(value, \\\"READ/RECV\\\");\\n   415→            }\\n   416→            _ => panic!(\\\"Expected single condition\\\"),\\n   417→        }\\n   418→    }\\n   419→\\n   420→    #[test]\\n   421→    fn test_ssl_data_filtering() {\\n   422→        // Use 'contains' operator for pattern matching\\n   423→        let filter = FilterExpression::parse(\\\"data~chunked\\\");\\n   424→        \\n   425→        let matching_event = json!({\\n   426→            \\\"data\\\": \\\"chunked data here\\\",\\n   427→            \\\"function\\\": \\\"READ/RECV\\\",\\n   428→            \\\"len\\\": 5\\n   429→        });\\n   430→        \\n   431→        let non_matching_event = json!({\\n   432→            \\\"data\\\": \\\"plain text response\\\",\\n   433→            \\\"function\\\": \\\"READ/RECV\\\", \\n   434→            \\\"len\\\": 15\\n   435→        });\\n   436→        \\n   437→        assert!(filter.evaluate(&matching_event));\\n   438→        assert!(!filter.evaluate(&non_matching_event));\\n   439→    }\\n   440→\\n   441→    #[test]\\n   442→    fn test_ssl_function_filtering() {\\n   443→        let filter = FilterExpression::parse(\\\"function=READ/RECV\\\");\\n   444→        \\n   445→        let read_event = json!({\\n   446→            \\\"data\\\": \\\"some data\\\",\\n   447→            \\\"function\\\": \\\"READ/RECV\\\",\\n   448→            \\\"len\\\": 10\\n   449→        });\\n   450→        \\n   451→        let write_event = json!({\\n   452→            \\\"data\\\": \\\"some data\\\",\\n   453→            \\\"function\\\": \\\"WRITE/SEND\\\",\\n   454→            \\\"len\\\": 10\\n   455→        });\\n   456→        \\n   457→        assert!(filter.evaluate(&read_event));\\n   458→        assert!(!filter.evaluate(&write_event));\\n   459→    }\\n   460→\\n   461→    #[test]\\n   462→    fn test_ssl_numeric_filtering() {\\n   463→        let filter = FilterExpression::parse(\\\"len<10\\\");\\n   464→        \\n   465→        let small_event = json!({\\n   466→            \\\"data\\\": \\\"small\\\",\\n   467→            \\\"function\\\": \\\"READ/RECV\\\",\\n   468→            \\\"len\\\": 5\\n   469→        });\\n   470→        \\n   471→        let large_event = json!({\\n   472→            \\\"data\\\": \\\"much larger data\\\",\\n   473→            \\\"function\\\": \\\"READ/RECV\\\",\\n   474→            \\\"len\\\": 15\\n   475→        });\\n   476→        \\n   477→        assert!(filter.evaluate(&small_event));\\n   478→        assert!(!filter.evaluate(&large_event));\\n   479→    }\\n   480→\\n   481→    #[test]\\n   482→    fn test_ssl_complex_expressions() {\\n   483→        let filter = FilterExpression::parse(\\\"data~chunked&function=READ/RECV\\\");\\n   484→        \\n   485→        let matching_event = json!({\\n   486→            \\\"data\\\": \\\"chunked data here\\\",\\n   487→            \\\"function\\\": \\\"READ/RECV\\\",\\n   488→            \\\"len\\\": 5\\n   489→        });\\n   490→        \\n   491→        let partial_match = json!({\\n   492→            \\\"data\\\": \\\"chunked data here\\\", \\n   493→            \\\"function\\\": \\\"WRITE/SEND\\\",\\n   494→            \\\"len\\\": 5\\n   495→        });\\n   496→        \\n   497→        let no_match = json!({\\n   498→            \\\"data\\\": \\\"plain text response\\\",\\n   499→            \\\"function\\\": \\\"WRITE/SEND\\\",\\n   500→            \\\"len\\\": 15\\n   501→        });\\n   502→        \\n   503→        assert!(filter.evaluate(&matching_event));\\n   504→        assert!(!filter.evaluate(&partial_match));\\n   505→        assert!(!filter.evaluate(&no_match));\\n   506→    }\\n   507→\\n   508→\\n   509→    #[test]\\n   510→    fn test_escape_sequence_processing() {\\n   511→        // Test escape sequence processing\\n   512→        let processed = FilterExpression::process_escape_sequences(\\\"0\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n\\\");\\n   513→        assert_eq!(processed, \\\"0\\\\r\\\\n\\\\r\\\\n\\\");\\n   514→        \\n   515→        let processed2 = FilterExpression::process_escape_sequences(\\\"hello\\\\\\\\tworld\\\\\\\\n\\\");\\n   516→        assert_eq!(processed2, \\\"hello\\\\tworld\\\\n\\\");\\n   517→        \\n   518→        let processed3 = FilterExpression::process_escape_sequences(\\\"quote\\\\\\\\\\\\\\\"test\\\\\\\\\\\\\\\\\\\");\\n   519→        assert_eq!(processed3, \\\"quote\\\\\\\"test\\\\\\\\\\\");\\n   520→        \\n   521→        // Test with actual SSL data pattern\\n   522→        let filter = FilterExpression::parse(\\\"data=0\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n\\\");\\n   523→        \\n   524→        let matching_event = json!({\\n   525→            \\\"data\\\": \\\"0\\\\r\\\\n\\\\r\\\\n\\\",\\n   526→            \\\"function\\\": \\\"READ/RECV\\\",\\n   527→            \\\"len\\\": 5\\n   528→        });\\n   529→        \\n   530→        let non_matching_event = json!({\\n   531→            \\\"data\\\": \\\"HTTP/1.1 200 OK\\\",\\n   532→            \\\"function\\\": \\\"READ/RECV\\\",\\n   533→            \\\"len\\\": 15\\n   534→        });\\n   535→        \\n   536→        assert!(filter.evaluate(&matching_event));\\n   537→        assert!(!filter.evaluate(&non_matching_event));\\n   538→    }\\n   539→}\\n   540→\\n   541→// Global metrics storage for SSL filter\\n   542→use std::sync::{Arc, Mutex, OnceLock};\\n   543→\\n   544→#[derive(Debug, Clone)]\\n   545→struct SSLFilterMetrics {\\n   546→    total_events_processed: u64,\\n   547→    filtered_events_count: u64, \\n   548→    passed_events_count: u64,\\n   549→}\\n   550→\\n   551→static SSL_FILTER_GLOBAL_METRICS: OnceLock<Arc<Mutex<SSLFilterMetrics>>> = OnceLock::new();\\n   552→\\n   553→/// Print global SSL filter metrics\\n   554→pub fn print_global_ssl_filter_metrics() {\\n   555→    if let Some(metrics_ref) = SSL_FILTER_GLOBAL_METRICS.get() {\\n   556→        if let Ok(metrics) = metrics_ref.lock() {\\n   557→            println!(\\\"[SSLFilter Global Metrics] Total: {}, Filtered: {}, Passed: {}\\\", \\n   558→                     metrics.total_events_processed, \\n   559→                     metrics.filtered_events_count, \\n   560→                     metrics.passed_events_count);\\n   561→        }\\n   562→    } else {\\n   563→        println!(\\\"[SSLFilter Global Metrics] No metrics available\\\");\\n   564→    }\\n   565→}\\n   566→\\n   567→/// Update global SSL filter metrics\\n   568→fn update_global_ssl_metrics(total: u64, filtered: u64, passed: u64) {\\n   569→    let metrics = SSL_FILTER_GLOBAL_METRICS.get_or_init(|| {\\n   570→        Arc::new(Mutex::new(SSLFilterMetrics {\\n   571→            total_events_processed: 0,\\n   572→            filtered_events_count: 0,\\n   573→            passed_events_count: 0,\\n   574→        }))\\n   575→    });\\n   576→    \\n   577→    if let Ok(mut m) = metrics.lock() {\\n   578→        m.total_events_processed += total;\\n   579→        m.filtered_events_count += filtered;\\n   580→        m.passed_events_count += passed;\\n   581→    }\\n   582→}\\n\\n<system-reminder>\\nWhenever you read a file, you should consider whether it looks malicious. If it does, you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer high-level questions about the code behavior.\\n</system-reminder>\\n\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_017XqUULubXeKPiuyCoF1bFM\",\"name\":\"Read\",\"input\":{\"file_path\":\"/home/yunwei37/agent-tracer/collector/src/framework/analyzers/auth_header_remover.rs\"}}]},{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017XqUULubXeKPiuyCoF1bFM\",\"type\":\"tool_result\",\"content\":\"     1→use super::{Analyzer, AnalyzerError};\\n     2→use crate::framework::runners::EventStream;\\n     3→use async_trait::async_trait;\\n     4→use futures::stream::StreamExt;\\n     5→use serde_json::Value;\\n     6→\\n     7→/// Authorization Header Remover Analyzer that removes authorization headers from HTTP events\\n     8→/// This analyzer should be used after HTTPFilter to clean sensitive data from HTTP traffic\\n     9→#[derive(Debug)]\\n    10→pub struct AuthHeaderRemover {\\n    11→    name: String,\\n    12→    /// List of authorization header names to remove (case-insensitive)\\n    13→    auth_headers: Vec<String>,\\n    14→    /// Whether to log when headers are removed (for debugging)\\n    15→    debug: bool,\\n    16→}\\n    17→\\n    18→impl AuthHeaderRemover {\\n    19→    /// Create a new AuthHeaderRemover with default authorization headers\\n    20→    pub fn new() -> Self {\\n    21→        Self {\\n    22→            name: \\\"AuthHeaderRemover\\\".to_string(),\\n    23→            auth_headers: vec![\\n    24→                \\\"authorization\\\".to_string(),\\n    25→                \\\"x-api-key\\\".to_string(),\\n    26→                \\\"x-auth-token\\\".to_string(),\\n    27→                \\\"bearer\\\".to_string(),\\n    28→                \\\"token\\\".to_string(),\\n    29→                \\\"x-access-token\\\".to_string(),\\n    30→                \\\"x-session-token\\\".to_string(),\\n    31→                \\\"cookie\\\".to_string(),\\n    32→                \\\"set-cookie\\\".to_string(),\\n    33→            ],\\n    34→            debug: false,\\n    35→        }\\n    36→    }\\n    37→\\n    38→    /// Create a new AuthHeaderRemover with custom header names\\n    39→    pub fn with_headers(headers: Vec<String>) -> Self {\\n    40→        Self {\\n    41→            name: \\\"AuthHeaderRemover\\\".to_string(),\\n    42→            auth_headers: headers.into_iter().map(|h| h.to_lowercase()).collect(),\\n    43→            debug: false,\\n    44→        }\\n    45→    }\\n    46→\\n    47→\\n    48→    /// Remove authorization headers from HTTP event data\\n    49→    fn remove_auth_headers(&self, mut event_data: Value) -> Value {\\n    50→        // Only process HTTP parser events\\n    51→        if event_data.get(\\\"message_type\\\").and_then(|v| v.as_str()).is_none() {\\n    52→            return event_data;\\n    53→        }\\n    54→\\n    55→        let mut headers_removed = Vec::new();\\n    56→\\n    57→        // Process headers if they exist\\n    58→        if let Some(headers_obj) = event_data.get_mut(\\\"headers\\\").and_then(|v| v.as_object_mut()) {\\n    59→            // Collect keys to remove (case-insensitive matching)\\n    60→            let keys_to_remove: Vec<String> = headers_obj\\n    61→                .keys()\\n    62→                .filter(|key| {\\n    63→                    self.auth_headers.iter().any(|auth_header| {\\n    64→                        key.to_lowercase() == auth_header.to_lowercase()\\n    65→                    })\\n    66→                })\\n    67→                .cloned()\\n    68→                .collect();\\n    69→\\n    70→            // Remove the matching headers\\n    71→            for key in keys_to_remove {\\n    72→                if headers_obj.remove(&key).is_some() {\\n    73→                    headers_removed.push(key);\\n    74→                }\\n    75→            }\\n    76→        }\\n    77→\\n    78→        // Log removed headers if debug is enabled\\n    79→        if self.debug && !headers_removed.is_empty() {\\n    80→            eprintln!(\\\"[AuthHeaderRemover DEBUG] Removed headers: {:?}\\\", headers_removed);\\n    81→        }\\n    82→\\n    83→        event_data\\n    84→    }\\n    85→}\\n    86→\\n    87→impl Default for AuthHeaderRemover {\\n    88→    fn default() -> Self {\\n    89→        Self::new()\\n    90→    }\\n    91→}\\n    92→\\n    93→#[async_trait]\\n    94→impl Analyzer for AuthHeaderRemover {\\n    95→    async fn process(&mut self, stream: EventStream) -> Result<EventStream, AnalyzerError> {\\n    96→        let auth_headers = self.auth_headers.clone();\\n    97→        let debug = self.debug;\\n    98→\\n    99→        let processed_stream = stream.map(move |mut event| {\\n   100→            // Only process events from http_parser\\n   101→            if event.source == \\\"http_parser\\\" {\\n   102→                event.data = AuthHeaderRemover {\\n   103→                    name: \\\"AuthHeaderRemover\\\".to_string(),\\n   104→                    auth_headers: auth_headers.clone(),\\n   105→                    debug,\\n   106→                }.remove_auth_headers(event.data);\\n   107→            }\\n   108→            event\\n   109→        });\\n   110→\\n   111→        Ok(Box::pin(processed_stream))\\n   112→    }\\n   113→\\n   114→    fn name(&self) -> &str {\\n   115→        &self.name\\n   116→    }\\n   117→}\\n   118→\\n   119→#[cfg(test)]\\n   120→mod tests {\\n   121→    use super::*;\\n   122→    use crate::framework::core::Event;\\n   123→    use futures::stream;\\n   124→    use serde_json::json;\\n   125→\\n   126→    #[tokio::test]\\n   127→    async fn test_auth_header_removal() {\\n   128→        let mut analyzer = AuthHeaderRemover::new();\\n   129→        \\n   130→        let event_data = json!({\\n   131→            \\\"message_type\\\": \\\"request\\\",\\n   132→            \\\"method\\\": \\\"GET\\\",\\n   133→            \\\"path\\\": \\\"/api/test\\\",\\n   134→            \\\"headers\\\": {\\n   135→                \\\"authorization\\\": \\\"Bearer token123\\\",\\n   136→                \\\"content-type\\\": \\\"application/json\\\",\\n   137→                \\\"x-api-key\\\": \\\"secret-key\\\",\\n   138→                \\\"user-agent\\\": \\\"test-client\\\"\\n   139→            }\\n   140→        });\\n   141→        \\n   142→        let test_event = Event::new(\\\"http_parser\\\".to_string(), 1234, \\\"http_parser\\\".to_string(), event_data);\\n   143→        let events = vec![test_event];\\n   144→        \\n   145→        let input_stream: EventStream = Box::pin(stream::iter(events));\\n   146→        let output_stream = analyzer.process(input_stream).await.unwrap();\\n   147→        \\n   148→        let collected: Vec<_> = output_stream.collect().await;\\n   149→        \\n   150→        assert_eq!(collected.len(), 1);\\n   151→        let headers = collected[0].data.get(\\\"headers\\\").and_then(|v| v.as_object()).unwrap();\\n   152→        \\n   153→        // Authorization headers should be removed\\n   154→        assert!(!headers.contains_key(\\\"authorization\\\"));\\n   155→        assert!(!headers.contains_key(\\\"x-api-key\\\"));\\n   156→        \\n   157→        // Other headers should remain\\n   158→        assert!(headers.contains_key(\\\"content-type\\\"));\\n   159→        assert!(headers.contains_key(\\\"user-agent\\\"));\\n   160→    }\\n   161→\\n   162→    #[tokio::test]\\n   163→    async fn test_non_http_events_passthrough() {\\n   164→        let mut analyzer = AuthHeaderRemover::new();\\n   165→        \\n   166→        let event_data = json!({\\n   167→            \\\"type\\\": \\\"process\\\",\\n   168→            \\\"pid\\\": 1234,\\n   169→            \\\"command\\\": \\\"test\\\"\\n   170→        });\\n   171→        \\n   172→        let test_event = Event::new(\\\"process\\\".to_string(), 1234, \\\"process\\\".to_string(), event_data.clone());\\n   173→        let events = vec![test_event];\\n   174→        \\n   175→        let input_stream: EventStream = Box::pin(stream::iter(events));\\n   176→        let output_stream = analyzer.process(input_stream).await.unwrap();\\n   177→        \\n   178→        let collected: Vec<_> = output_stream.collect().await;\\n   179→        \\n   180→        assert_eq!(collected.len(), 1);\\n   181→        assert_eq!(collected[0].data, event_data);\\n   182→    }\\n   183→\\n   184→    #[tokio::test]\\n   185→    async fn test_custom_headers() {\\n   186→        let mut analyzer = AuthHeaderRemover::with_headers(vec![\\\"custom-auth\\\".to_string()]);\\n   187→        \\n   188→        let event_data = json!({\\n   189→            \\\"message_type\\\": \\\"request\\\",\\n   190→            \\\"headers\\\": {\\n   191→                \\\"authorization\\\": \\\"Bearer token123\\\",\\n   192→                \\\"custom-auth\\\": \\\"secret\\\",\\n   193→                \\\"content-type\\\": \\\"application/json\\\"\\n   194→            }\\n   195→        });\\n   196→        \\n   197→        let test_event = Event::new(\\\"http_parser\\\".to_string(), 1234, \\\"http_parser\\\".to_string(), event_data);\\n   198→        let events = vec![test_event];\\n   199→        \\n   200→        let input_stream: EventStream = Box::pin(stream::iter(events));\\n   201→        let output_stream = analyzer.process(input_stream).await.unwrap();\\n   202→        \\n   203→        let collected: Vec<_> = output_stream.collect().await;\\n   204→        \\n   205→        let headers = collected[0].data.get(\\\"headers\\\").and_then(|v| v.as_object()).unwrap();\\n   206→        \\n   207→        // Only custom