pe ViewMode = 'log' | 'timeline' | 'process-tree';\\n    11→\\n    12→export default function Home() {\\n    13→  const [file, setFile] = useState<File | null>(null);\\n    14→  const [logContent, setLogContent] = useState<string>('');\\n    15→  const [events, setEvents] = useState<Event[]>([]);\\n    16→  const [viewMode, setViewMode] = useState<ViewMode>('process-tree');\\n    17→  const [loading, setLoading] = useState(false);\\n    18→  const [syncing, setSyncing] = useState(false);\\n    19→  const [error, setError] = useState<string>('');\\n    20→  const [isParsed, setIsParsed] = useState(false);\\n    21→  const [showUploadPanel, setShowUploadPanel] = useState(false);\\n    22→\\n    23→  const parseLogContent = (content: string) => {\\n    24→    if (!content.trim()) {\\n    25→      setError('Empty log content');\\n    26→      return;\\n    27→    }\\n    28→\\n    29→    setLoading(true);\\n    30→    setError('');\\n    31→\\n    32→    try {\\n    33→      const lines = content.split('\\\\n').filter(line => line.trim());\\n    34→      const parsedEvents: Event[] = [];\\n    35→      const errors: string[] = [];\\n    36→\\n    37→      lines.forEach((line, index) => {\\n    38→        try {\\n    39→          const event = JSON.parse(line.trim()) as Event;\\n    40→          \\n    41→          // Validate event structure - auto-generate id if missing\\n    42→          if (event.timestamp && event.source && event.data) {\\n    43→            if (!event.id) {\\n    44→              event.id = `${event.source}-${event.timestamp}-${index}`;\\n    45→            }\\n    46→            parsedEvents.push(event);\\n    47→          } else {\\n    48→            // Track validation errors\\n    49→            const missing = [];\\n    50→            if (!event.timestamp) missing.push('timestamp');\\n    51→            if (!event.source) missing.push('source');\\n    52→            if (!event.data) missing.push('data');\\n    53→            errors.push(`Line