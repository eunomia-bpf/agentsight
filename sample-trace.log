nput_json_delta\",\"partial_json\":\"{\\\"pattern\\\": \\\"API|api|/api/|WebServer|server\"}       }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"{\"pattern\": \"API|api|/api/|WebServer|server","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\", \\\"include\\\": \\\"*.rs\"}              }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"\", \"include\": \"*.rs","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\", \\\"path\\\": \\\"/home/yunwei37/agent-tracer/frontend/src\"}           }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"\", \"path\": \"/home/yunwei37/agent-tracer/frontend/src","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\"}\"}             }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"partial_json":"\"}","type":"input_json_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_stop\",\"index\":0       }","event":"content_block_stop","id":null,"parsed_data":{"index":0,"type":"content_block_stop"},"raw_data":null},{"data":"{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null},\"usage\":{\"output_tokens\":112}       }","event":"message_delta","id":null,"parsed_data":{"delta":{"stop_reason":"tool_use","stop_sequence":null},"type":"message_delta","usage":{"output_tokens":112}},"raw_data":null},{"data":"{\"type\":\"message_stop\" }","event":"message_stop","id":null,"parsed_data":{"type":"message_stop"},"r