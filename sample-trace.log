 7→#[derive(RustEmbed)]\\n     8→#[folder = \\\"../frontend/dist/\\\"]\\n     9→pub struct FrontendDist;\\n    10→\\n    11→pub struct FrontendAssets {\\n    12→    temp_dir: PathBuf,\\n    13→}\\n    14→\\n    15→impl FrontendAssets {\\n    16→    pub fn new() -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {\\n    17→        let temp_dir = std::env::temp_dir().join(format!(\\\"agentsight-frontend-{}\\\", uuid::Uuid::new_v4()));\\n    18→        fs::create_dir_all(&temp_dir)?;\\n    19→        \\n    20→        // Extract all embedded assets to temp directory\\n    21→        for file_path in FrontendDist::iter() {\\n    22→            if let Some(content) = FrontendDist::get(&file_path) {\\n    23→                let full_path = temp_dir.join(&*file_path);\\n    24→                if let Some(parent) = full_path.parent() {\\n    25→                    fs::create_dir_all(parent)?;\\n    26→                }\\n    27→                fs::write(&full_path, &content.data)?;\\n    28→            }\\n    29→        }\\n    30→        \\n    31→        log::info!(\\\"📁 Extracted frontend assets to: {}\\\", temp_dir.display());\\n    32→        Ok(Self { temp_dir })\\n    33→    }\\n    34→    \\n    35→    /// Get any asset by path from the extracted temp directory\\n    36→    pub fn get(&self, path: &str) -> Option<Cow<'static, [u8]>> {\\n    37→        // Handle root path\\n    38→        let file_path = if path == \\\"/\\\" || path == \\\"/index.html\\\" {\\n    39→            self.temp_dir.join(\\\"index.html\\\")\\n    40→        } else {\\n    41→            // Remove leading slash for file lookup\\n    42→            let normalized_path = path.strip_prefix('/').unwrap_or(path);\\n    43→            self.temp_dir.join(normalized_path)\\n    44→        };\\n    45→        \\n    46→        // Try to read from temp directory\\n    47→        if let Ok(content) = fs::read(&file_path) {\\n    48→            Some(Cow::Owned(content))\\n    49→        } else {\