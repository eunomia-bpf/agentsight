delta","id":null,"parsed_data":{"delta":{"text":"--max-log-size` parameter for log","type":"text_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\" rotation\\n- **New**: Global\"}              }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"text":" rotation\n- **New**: Global","type":"text_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\" metrics printing on shutdown (HTTP an\"}}","event":"content_block_delta","id":null,"parsed_data":{"delta":{"text":" metrics printing on shutdown (HTTP an","type":"text_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"d SSL filter metrics)\\n- **New**: Real\"}      }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"text":"d SSL filter metrics)\n- **New**: Real","type":"text_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"-time event broadcasting for web interface\"}              }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"text":"-time event broadcasting for web interface","type":"text_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"\\n\\n## Key Architecture Improvements\\n\\n### 12. **\"}  }","event":"content_block_delta","id":null,"parsed_data":{"delta":{"text":"\n\n## Key Architecture Improvements\n\n### 12. **","type":"text_delta"},"index":0,"type":"content_block_delta"},"raw_data":null},{"data":"{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Binary E