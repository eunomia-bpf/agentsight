cs();\\n    34→        \\n    35→        // Print SSL filter metrics using the global function\\n    36→        print_global_ssl_filter_metrics();\\n    37→        \\n    38→        SHUTDOWN_REQUESTED.store(true, Ordering::Relaxed);\\n    39→        std::process::exit(0);\\n    40→    });\\n    41→}\\n    42→\\n    43→#[derive(Parser)]\\n    44→#[command(author, version, about, long_about = None)]\\n    45→struct Cli {\\n    46→    #[command(subcommand)]\\n    47→    command: Commands,\\n    48→}\\n    49→\\n    50→#[derive(Subcommand)]\\n    51→enum Commands {\\n    52→    /// Analyze SSL traffic with raw JSON output\\n    53→    Ssl {\\n    54→        /// Enable SSE processing for SSL traffic\\n    55→        #[arg(long)]\\n    56→        sse_merge: bool,\\n    57→        /// Enable HTTP parsing (automatically enables SSE merge first)\\n    58→        #[arg(long)]\\n    59→        http_parser: bool,\\n    60→        /// Include raw SSL data in HTTP parser events\\n    61→        #[arg(long)]\\n    62→        http_raw_data: bool,\\n    63→        /// HTTP filter patterns to exclude events (can be used multiple times)\\n    64→        #[arg(long)]\\n    65→        http_filter: Vec<String>,\\n    66→        /// Disable authorization header removal from HTTP traffic\\n    67→        #[arg(long)]\\n    68→        disable_auth_removal: bool,\\n    69→        /// SSL filter patterns to exclude events (can be used multiple times)\\n    70→        #[arg(long)]\\n    71→        ssl_filter: Vec<String>,\\n    72→        /// Suppress console output\\n    73→        #[arg(short, long)]\\n    74→        quiet: bool,\\n    75→        /// Enable log rotation\\n    76→        #[arg(long)]\\n    77→        rotate_logs: bool,\\n    78→        /// Maximum log file size in MB (used with --rotate-logs)\\n    79→        #[arg(long, default_value = \\\"10\\\")]\\n    80→        max_log_size: u64,\\n    81→        /// Start web server on port 7395\\n    82→        #[arg(long)]\\n    83→  