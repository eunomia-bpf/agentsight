cpListener;\\n    12→use tokio::sync::broadcast;\\n    13→\\n    14→pub struct WebServer {\\n    15→    assets: Arc<FrontendAssets>,\\n    16→    event_sender: broadcast::Sender<Event>,\\n    17→    log_file: Option<String>,\\n    18→}\\n    19→\\n    20→impl WebServer {\\n    21→    pub fn new(event_sender: broadcast::Sender<Event>, log_file: Option<&str>) -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {\\n    22→        let assets = FrontendAssets::new()?;\\n    23→        Ok(Self {\\n    24→            assets: Arc::new(assets),\\n    25→            event_sender,\\n    26→            log_file: log_file.map(|s| s.to_string()),\\n    27→        })\\n    28→    }\\n    29→    \\n    30→    pub async fn start(&self, addr: SocketAddr) -> std::result::Result<(), Box<dyn std::error::Error + Send + Sync>> {\\n    31→        let listener = TcpListener::bind(addr).await.map_err(|e| Box::new(e) as Box<dyn std::error::Error + Send + Sync>)?;\\n    32→        log::info!(\\\"🚀 Frontend server running on http://{}\\\", addr);\\n    33→        \\n    34→        // List embedded assets for debugging\\n    35→        let all_assets = self.assets.list_all_assets();\\n    36→        log::info!(\\\"📦 Embedded {} assets from frontend/dist:\\\", all_assets.len());\\n    37→        for asset in all_assets.iter().take(10) {\\n    38→            log::info!(\\\"   - {}\\\", asset);\\n    39→        }\\n    40→        if all_assets.len() > 10 {\\n    41→            log::info!(\\\"   ... and {} more\\\", all_assets.len() - 10);\\n    42→        }\\n    43→        \\n    44→        loop {\\n    45→            let (stream, _) = listener.accept().await.map_err(|e| Box::new(e) as Box<dyn std::error::Error + Send + Sync>)?;\\n    46→            let assets = Arc::clone(&self.assets);\\n    47→            let event_sender = self.event_sender.clone();\\n    48→            let log_file = self.log_file.clone();\\n    49→            \\n    50→            tokio::spawn(async move {\\n    51→                let io = TokioIo::new(stream);\\n    52→                let service = service_fn(move |req| {\\n    53→                    handle_request(req, assets.clone(), event_sender.clone(), log_file.clone())\\n    54→                });\\n    55→                \\n    56→                if let Err(err) = http1::Builder::new()\\n    57→                    .serve_connection(io, service)\\n    58→                    .await\\n    59→                {\\n    60→                    log::error!(\\\"❌ Error serving connection: {:?}\\\", err);\\n    61→                }\\n    62→            });\\n    63→        }\\n    64→    }\\n    65→}\\n    66→\\n    67→async fn handle_request(\\n    68→    req: Request<hyper::body::Incoming>,\\n    69→    assets: Arc<FrontendAssets>,\\n    70→    event_sender: broadcast::Sender<Event>,\\n    71→    log_file: Option<String>,\\n    72→) -> std::result::Result<Response<Full<Bytes>>, Infallible> {\\n    73→    let path = req.uri().path();\\n    74→    \\n    75→    log::info!(\\\"📨 {} {}\\\", req.method(), path);\\n    76→    \\n    77→    match (req.method(), path) {\\n    78→        // API endpoints first\\n    79→        (&Method::GET, \\\"/api/events\\\") => {\\n    80→            serve_events_api(event_sender, log_file).await\\n    81→        }\\n    82→        (&Method::GET, \\\"/api/assets\\\") => {\\n    83→            serve_assets_list(assets).await\\n    84→        }\\n    85→        \\n    86→        // Serve static assets (catch-all for GET requests)\\n    87→        (&Method::GET, _) => {\\n    88→            serve_asset(assets, path).await\\n    89→        }\\n    90→        \\n    91→        // 404 for non-GET methods\\n    92→        _ => {\\n    93→            log::info!(\\\"❌ 404 Not Found: {} {}\\\", req.method(), path);\\n    94→            Ok(Response::builder()\\n    95→                .status(StatusCode::NOT_FOUND)\\n    96→                .header(\\\"Content-Type\\\", \\\"text/plain\\\")\\n    97→                .body(Full::new(Bytes::from(\\\"Not Found\\\")))\\n    98→                .unwrap())\\n    99→        }\\n   100→    }\\n   101→}\\n   102→\\n   103→async fn serve_asset(\\n   104→    assets: Arc<FrontendAssets>,\\n   105→    path: &str,\\n   106→) -> std::result::Result<Response<Full<Bytes>>, Infallible> {\\n   107→    if let Some(content) = assets.get(path) {\\n   108→        let content_type = assets.get_content_type(path);\\n   109→        log::info!(\\\"✅ Serving asset: {} ({})\\\", path, content_type);\\n   110→        Ok(Response::builder()\\n   111→            .header(\\\"Content-Type\\\", content_type)\\n   112→            .header(\\\"Cache-Control\\\", \\\"public, max-age=31536000\\\")\\n   113→            .body(Full::new(Bytes::from(content.to_vec())))\\n   114→            .unwrap())\\n   115→    } else {\\n   116→        log::info!(\\\"❌ Asset not found: {}\\\", path);\\n   117→        Ok(Response::builder()\\n   118→            .status(StatusCode::NOT_FOUND)\\n   119→            .header(\\\"Content-Type\\\", \\\"text/plain\\\")\\n   120→            .body(Full::new(Bytes::from(\\\"Asset not found\\\")))\\n   121→            .unwrap())\\n   122→    }\\n   123→}\\n   124→\\n   125→async fn serve_events_api(\\n   126→    _event_sender: broadcast::Sender<Event>,\\n   127→    log_file: Option<String>,\\n   128→) -> std::result::Result<Response<Full<Bytes>>, Infallible> {\\n   129→    // If log file is specified, read and return its contents\\n   130→    if let Some(log_path) = log_file {\\n   131→        match tokio::fs::read_to_string(&log_path).await {\\n   132→            Ok(content) => {\\n   133→                log::info!(\\\"📊 Serving log file: {} ({} bytes)\\\", log_path, content.len());\\n   134→                Ok(Response::builder()\\n   135→                    .header(\\\"Content-Type\\\", \\\"text/plain\\\")\\n   136→                    .header(\\\"Access-Control-Allow-Origin\\\", \\\"*\\\")\\n   137→                    .body(Full::new(Bytes::from(c