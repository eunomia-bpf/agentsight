{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:wasm": "npm exec --package=wasm-pack@0.15.0 -c \"wasm-pack build ../agentsight-protocol --target web --out-dir ../frontend/src/generated/agentsight-protocol --no-pack\"",
    "predev": "npm run build:wasm",
    "dev": "next dev",
    "prebuild": "npm run build:wasm",
    "build": "next build",
    "test:workers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test scripts/build-workers.test.mjs src/lib/controllerOrigin.test.mjs src/lib/fleetData.test.mjs src/lib/nodeOpening.test.mjs src/utils/sessionData.test.mjs",
    "test:e2e": "playwright test",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "diff": "^8.0.2",
    "next": "^15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
