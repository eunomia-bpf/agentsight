{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Keep the deployed Worker slug for URL/OAuth compatibility. The product
  // and repository concept is Controller; the hostname can be migrated later.
  "name": "agentsight-control",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "vars": {
    "APP_ORIGIN": "https://app.agentsight.us"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsight-control",
      "database_id": "19e9a84d-25a7-4bb7-8de8-f1ba01b89862"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NODE_RELAY", "class_name": "NodeRelay" }
    ]
  },
  "migrations": [
    { "tag": "relay-v1", "new_sqlite_classes": ["NodeRelay"] }
  ],
  "ratelimits": [
    {
      "name": "OAUTH_IP_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "OAUTH_LOCATION_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
