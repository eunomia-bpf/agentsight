{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The stable hosted endpoint is https://control.agentsight.us. Keep that
  // custom domain attached to this Worker in the agentsight.us zone.
  "name": "agentsight-control",
  "account_id": "d9c543e4c98332379705cad72b658b78",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "control.agentsight.us", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.agentsight.us",
    "APP_PREVIEW_ORIGIN": "https://controller-agentsight-domain-agentsight.yunwei356.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsight-control",
      "database_id": "e568196c-8d0e-4f0e-9161-2b4e0ae96a29"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NODE_RELAY", "class_name": "NodeRelay" }
    ]
  },
  "migrations": [
    { "tag": "relay-v1", "new_sqlite_classes": ["NodeRelay"] }
  ],
  "ratelimits": [
    {
      "name": "OAUTH_IP_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "OAUTH_LOCATION_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 100, "period": 60 }
    }
  ]
}
