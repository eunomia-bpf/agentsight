{
  "name": "agentsight-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "deploy": "cd .. && wrangler deploy --config wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config ../wrangler.jsonc",
    "dev": "cd .. && wrangler dev --config wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.120.1"
  }
}
